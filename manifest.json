{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.7.1",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["clipboardWrite", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"],
      "js": ["src/font-settings.js", "src/chatgpt-fonts.js"],
      "css": ["src/chatgpt-fonts.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "src/latex-normalizer.js",
        "src/word-mathml.js",
        "src/word-text.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/SourceSans3-Regular.woff2",
        "fonts/SourceSans3-Italic.woff2",
        "fonts/SourceSerif4-Regular.woff2",
        "fonts/SourceSerif4-Italic.woff2",
        "fonts/arimo-latin-wght-normal.woff2",
        "fonts/arimo-latin-wght-italic.woff2",
        "fonts/tinos-latin-400-normal.woff2",
        "fonts/tinos-latin-400-italic.woff2",
        "fonts/tinos-latin-700-normal.woff2",
        "fonts/tinos-latin-700-italic.woff2"
      ],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*"]
    }
  ]
}
